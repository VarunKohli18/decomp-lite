# Ghidra: needed for the pseudoc input only.
GHIDRA_INSTALL_DIR=/opt/ghidra           # Ghidra install folder

# vLLM: used by provider vllm.
VLLM_BASE_URL=http://localhost:8000      # server address
VLLM_API_KEY=                            # API key; empty if the server needs none

# Ollama: used by provider ollama.
OLLAMA_BASE_URL=http://localhost:11434   # server address

# API models: used by provider anthropic (Claude) and openai (GPT).
ANTHROPIC_API_KEY=                       # Claude API key
OPENAI_API_KEY=                          # OpenAI API key
